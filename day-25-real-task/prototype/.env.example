# Ключ из личного кабинета https://developers.sber.ru/studio
# Вкладка "Настройки" → "Авторизационные данные" → скопировать Authorization Key
GIGACHAT_AUTHORIZATION_KEY=your_authorization_key_here

# Модель: GigaChat, GigaChat-Plus, GigaChat-Pro
GIGACHAT_MODEL=GigaChat

# Admin-пользователь (создаётся автоматически при первом запуске)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_please
